{
  "manifest_version": 3,
  "name": "Vinted AI",
  "short_name": "Vinted AI",
  "version": "1.1.0",
  "description": "Agent IA pour vendeurs Vinted : annonces générées depuis les photos, analyse de prix, bibliothèque avec numéros d'article, dashboard.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "cookies",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.vinted.fr/*",
    "https://www.vinted.be/*",
    "https://www.vinted.es/*",
    "https://www.vinted.it/*",
    "https://www.vinted.de/*",
    "https://www.vinted.nl/*",
    "https://www.vinted.pl/*",
    "https://www.vinted.pt/*",
    "https://www.vinted.lu/*",
    "https://www.vinted.at/*",
    "https://www.vinted.co.uk/*",
    "https://www.vinted.com/*",
    "https://www.vinted.cz/*",
    "https://www.vinted.lt/*",
    "https://www.vinted.se/*",
    "https://www.vinted.fi/*",
    "https://www.vinted.dk/*",
    "https://www.vinted.ie/*",
    "https://www.vinted.sk/*",
    "https://www.vinted.hu/*",
    "https://www.vinted.ro/*",
    "https://www.vinted.gr/*",
    "https://www.vinted.hr/*",
    "https://api.vinted.fr/*",
    "https://api.vinted.be/*",
    "https://api.vinted.es/*",
    "https://api.vinted.it/*",
    "https://api.vinted.de/*",
    "https://api.vinted.nl/*",
    "https://api.vinted.pl/*",
    "https://api.vinted.pt/*",
    "https://api.vinted.lu/*",
    "https://api.vinted.at/*",
    "https://api.vinted.co.uk/*",
    "https://api.vinted.com/*",
    "https://api.vinted.cz/*",
    "https://api.vinted.lt/*",
    "https://api.vinted.se/*",
    "https://api.vinted.fi/*",
    "https://api.vinted.dk/*",
    "https://api.vinted.ie/*",
    "https://api.vinted.sk/*",
    "https://api.vinted.hu/*",
    "https://api.vinted.ro/*",
    "https://api.vinted.gr/*",
    "https://api.vinted.hr/*",
    "https://*.vinted.net/*",
    "https://api.groq.com/*",
    "https://openrouter.ai/*",
    "https://api.openai.com/*",
    "https://api.mistral.ai/*",
    "https://html.duckduckgo.com/*",
    "https://lite.duckduckgo.com/*",
    "https://api.tavily.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.vinted.fr/*",
        "https://www.vinted.be/*",
        "https://www.vinted.es/*",
        "https://www.vinted.it/*",
        "https://www.vinted.de/*",
        "https://www.vinted.nl/*",
        "https://www.vinted.pl/*",
        "https://www.vinted.pt/*",
        "https://www.vinted.lu/*",
        "https://www.vinted.at/*",
        "https://www.vinted.co.uk/*",
        "https://www.vinted.com/*",
        "https://www.vinted.cz/*",
        "https://www.vinted.lt/*",
        "https://www.vinted.se/*",
        "https://www.vinted.fi/*",
        "https://www.vinted.dk/*",
        "https://www.vinted.ie/*",
        "https://www.vinted.sk/*",
        "https://www.vinted.hu/*",
        "https://www.vinted.ro/*",
        "https://www.vinted.gr/*",
        "https://www.vinted.hr/*"
      ],
      "js": [
        "shared/md.js",
        "shared/icons.js",
        "shared/chat-ui.js",
        "content/vinted-page.js",
        "content/panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "shared/tokens.css",
        "content/panel.css",
        "icons/*"
      ],
      "matches": [
        "https://www.vinted.fr/*",
        "https://www.vinted.be/*",
        "https://www.vinted.es/*",
        "https://www.vinted.it/*",
        "https://www.vinted.de/*",
        "https://www.vinted.nl/*",
        "https://www.vinted.pl/*",
        "https://www.vinted.pt/*",
        "https://www.vinted.lu/*",
        "https://www.vinted.at/*",
        "https://www.vinted.co.uk/*",
        "https://www.vinted.com/*",
        "https://www.vinted.cz/*",
        "https://www.vinted.lt/*",
        "https://www.vinted.se/*",
        "https://www.vinted.fi/*",
        "https://www.vinted.dk/*",
        "https://www.vinted.ie/*",
        "https://www.vinted.sk/*",
        "https://www.vinted.hu/*",
        "https://www.vinted.ro/*",
        "https://www.vinted.gr/*",
        "https://www.vinted.hr/*"
      ]
    }
  ]
}
